---
// src/layouts/components/Posts.astro
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify, summarize } from "@/lib/utils/textConverter";
import { Picture } from "astro:assets"; 
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  showSummary?: boolean;
  showAuthor?: boolean;
};

const { className, posts, showSummary = true, showAuthor = true } = Astro.props;
---

<div
  id="post-container"
  class={`row gy-5 gx-4 ${className}`}
>
  {
    posts.map((post) => (
      <div class="col-12 sm:col-6 lg:col-4">
        {post.data.image && (
          <div class="overflow-hidden rounded-xl mb-6 transition-all duration-300">
            <a
              href={`/blog/${post.id}/`}
              class="block aspect-16/10 overflow-hidden group"
            >
              <Picture
              class="group-hover:scale-105 transition duration-700 w-full h-full object-cover"
              src={post.data.image}
              alt={post.data.title}
              formats={["avif", "webp"]} 
              widths={[400, 800, 1200]}
              sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 445px"
              fallbackFormat="jpg" 
              loading="lazy"
              decoding="async"
              />
            </a>
          </div>
        )}
        <ul class="mb-3 flex items-center flex-nowrap whitespace-nowrap overflow-hidden text-xs font-bold uppercase text-text/70">
          {showAuthor && (
            <li class="flex items-center shrink-0">
              <a href={`/authors/${slugify(post.data.authors[0])}/`} class="hover:text-primary transition-colors">
                {post.data.authors[0]}
              </a>
              {post.data.authors.length > 1 && (
                <span class="ml-1 text-text/40 lowercase font-medium shrink-0">+</span>
              )}
            </li>
          )}
          <li class="flex items-center shrink-0">
            {showAuthor && <span class="mx-2 opacity-30 text-xs shrink-0">/</span>}
            {dateFormat(post.data.date!)}
          </li>
          <li class="flex items-center overflow-hidden min-w-0">
            <span class="mx-2 opacity-30 text-xs shrink-0">/</span>
            <a href={`/categories/${slugify(post.data.categories[0])}/`} class="hover:text-primary transition-colors truncate">
              {humanize(post.data.categories[0])}
            </a>
          </li>
        </ul>

        <h3 class="mb-3 h4 font-ui font-bold leading-tight">
          <a href={`/blog/${post.id}/`} class="block hover:text-primary transition-colors duration-300">
            {post.data.title}
          </a>
        </h3>

        {showSummary && (
          <p class="text-text line-clamp-2 text-sm leading-relaxed">
            {post.data.summary ?? summarize(post.body ?? "", 100)}
          </p>
        )}
      </div>
    ))
  }
</div>

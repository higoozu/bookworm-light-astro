---
import config from "@/config/config.json";
import {
  FaBluesky,
  FaShareNodes,
  FaLink,
  FaFacebook,
  FaLinkedin,
  FaXTwitter,
} from "react-icons/fa6";

const { base_url } = config.site;
const { title, description, slug, className, showCopy = true } = Astro.props;
const pathname = Astro.url?.pathname || `/${slug}`;
const shareUrl = `${base_url}${pathname}`;
const shareTitle = title ?? "";
const shareText = description ?? title ?? "";
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(shareTitle);
const encodedText = encodeURIComponent(`${shareTitle} ${shareUrl}`.trim());
---

<div class={`post-share ${className ?? ""}`} data-share-wrapper>
  <button
    type="button"
    class="post-share-trigger cursor-pointer"
    aria-label="share options"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-share-trigger
  >
    <FaShareNodes />
  </button>

  <div class="post-share-panel" role="dialog" aria-label="Share" data-share-panel hidden>
    {showCopy && (
      <button
        type="button"
        class="post-share-item post-share-copy cursor-pointer"
        data-share-copy={shareUrl}
        aria-label="copy link"
      >
        <FaLink />
        <span data-share-copy-text>Copy link</span>
      </button>
    )}

    <div class="post-share-divider"></div>

    <a
      class="post-share-item"
      href={`https://facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaFacebook />
      <span>Share on Facebook</span>
    </a>
    <a
      class="post-share-item"
      href={`https://twitter.com/intent/tweet/?text=${encodedTitle}&amp;url=${encodedUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaXTwitter />
      <span>Share on X</span>
    </a>
    <a
      class="post-share-item"
      href={`https://bsky.app/intent/compose?text=${encodedText}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaBluesky />
      <span>Share on Bluesky</span>
    </a>
    <a
      class="post-share-item"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}&summary=${encodeURIComponent(shareText)}&source=${base_url}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaLinkedin />
      <span>Share on LinkedIn</span>
    </a>
  </div>
</div>

<script define:vars={{ shareUrl, shareTitle, shareText }}>
  const wrappers = document.querySelectorAll("[data-share-wrapper]");

  const isMobile = () =>
    window.matchMedia("(max-width: 767px)").matches;

  const fallbackCopy = (value) => {
    const input = document.createElement("input");
    input.value = value;
    input.setAttribute("readonly", "");
    input.style.position = "absolute";
    input.style.left = "-9999px";
    document.body.appendChild(input);
    input.select();
    document.execCommand("copy");
    document.body.removeChild(input);
  };

  const closePanel = (panel, trigger) => {
    if (!panel || !trigger) return;
    panel.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  };

  wrappers.forEach((wrapper) => {
    const trigger = wrapper.querySelector("[data-share-trigger]");
    const panel = wrapper.querySelector("[data-share-panel]");
    const copyButton = wrapper.querySelector("[data-share-copy]");

    trigger?.addEventListener("click", async (event) => {
      if (isMobile() && navigator.share) {
        event.preventDefault();
        try {
          await navigator.share({
            title: shareTitle,
            text: shareText,
            url: shareUrl,
          });
        } catch (error) {
          // ignore user cancellation
        }
        return;
      }

      if (!panel) return;
      if (panel.hidden) {
        panel.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
      } else {
        closePanel(panel, trigger);
      }
    });

    copyButton?.addEventListener("click", async () => {
      const value = copyButton.getAttribute("data-share-copy") || shareUrl;
      try {
        await navigator.clipboard.writeText(value);
      } catch (error) {
        fallbackCopy(value);
      }
      copyButton.setAttribute("data-copied", "true");
      const textNode = copyButton.querySelector("[data-share-copy-text]");
      if (textNode) textNode.textContent = "Copied!";
      window.setTimeout(() => {
        copyButton.removeAttribute("data-copied");
        if (textNode) textNode.textContent = "Copy link";
      }, 1800);
    });

    document.addEventListener("click", (event) => {
      if (!panel || panel.hidden) return;
      if (wrapper.contains(event.target)) return;
      closePanel(panel, trigger);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePanel(panel, trigger);
    });
  });
</script>

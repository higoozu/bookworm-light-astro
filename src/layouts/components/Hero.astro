---
// src/layouts/components/Hero.astro
const { title, description, image, date, link } = Astro.props;
---

<section class="pt-8 pb-4">
  <div class="max-w-[1360px] mx-auto px-4">
    <a href={link} class="block relative w-full h-[65vh] md:h-[80vh] overflow-hidden rounded-[2.5rem] group shadow-sm">
      <div class="absolute inset-0 z-0">
        <img 
          src={image} 
          alt={title} 
          class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
      </div>
      
      <div class="absolute bottom-0 left-0 z-10 w-full p-10 md:p-20">
        <div class="max-w-2xl text-left animate-fade-in">
          <p class="text-[11px] md:text-sm uppercase tracking-[0.2em] mb-4 text-white/70 font-medium">
            {date}
          </p>
          <h1 class="text-4xl md:text-7xl font-bold mb-6 leading-[1.1] text-white">
            {title}
          </h1>
          <p class="text-lg md:text-xl text-white/80 font-light max-w-lg line-clamp-3">
            {description}
          </p>
        </div>
      </div>
    </a>
  </div>
</section>
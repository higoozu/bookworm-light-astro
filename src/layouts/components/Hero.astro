---
import { Image } from "astro:assets";
const { title, description, image, date } = Astro.props;
---

<section class="relative w-full h-[90vh] overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/20"></div> </div>
  
  <div class="container relative z-10 h-full flex flex-col justify-end pb-20 text-white">
    <div class="max-w-2xl text-left animate-fade-in">
      <p class="text-sm uppercase tracking-widest mb-4 opacity-80">{date}</p>
      <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">{title}</h1>
      <p class="text-lg md:text-xl opacity-90 font-light max-w-lg">{description}</p>
    </div>
  </div>
</section>

<style>
  .animate-fade-in {
    animation: fadeIn 1.2s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
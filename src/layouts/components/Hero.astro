---
// src/layouts/components/Hero.astro
import { Picture } from "astro:assets";

type Props = {
  title: string;
  description: string;
  image: string;
  date: string;
  link: string;
};

const { title, description, image, date, link } = Astro.props as Props;

// Import all images from src/assets
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif}"
);

// Resolve image path to module
const resolveImage = (imagePath: string) => {
  const assetPath = imagePath.startsWith("/images/")
    ? `/src/assets${imagePath}`
    : `/src/assets/images${imagePath}`;

  const imageModule = allImages[assetPath];
  return imageModule ? imageModule : null;
};

const imageModule = image ? resolveImage(image) : null;
---

<section class="pt-4 pb-4">
  <div class="max-w-340 mx-auto px-4">
    <a href={link} class="block relative w-full h-[65vh] md:h-[80vh] overflow-hidden rounded-4xl group shadow-sm bg-light transition-colors duration-300">
      <div class="absolute inset-0 z-0">
        {imageModule && (
          <Picture
            src={imageModule()}
            alt={title}
            formats={["avif", "webp"]}
            widths={[800, 1200, 1600]}
            sizes="100vw"
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            loading="eager"
            decoding="async"
          />
        )}
        <!-- Smarter gradient for text readability -->
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent dark:from-black/95 dark:via-black/40 opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
      </div>
      
      <div class="absolute bottom-0 left-0 z-10 w-full p-8 md:p-20">
        <div class="max-w-3xl text-left animate-fade-in translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-0.5 bg-primary rounded-full"></span>
            <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-neutral-100/80 font-bold">
              {date}
            </p>
          </div>
          <h1 class="text-4xl md:text-7xl font-bold mb-6 leading-[1.1] text-neutral-50 drop-shadow-md font-display italic">
            {title}
          </h1>
          <p class="text-lg md:text-xl text-neutral-100 font-medium max-w-xl line-clamp-3 leading-relaxed">
            {description}
          </p>
        </div>
      </div>
    </a>
  </div>
</section>

---
// src/layouts/components/PostCard.astro
import dateFormat from "@/lib/utils/dateFormat";
import { plainify, slugify } from "@/lib/utils/textConverter";
import { Picture } from "astro:assets";

const { post } = Astro.props;
const { title, image, date, summary, authors, categories } = post.data;
---

<div class="h-full group flex flex-col">
  {image && (
    <div class="overflow-hidden rounded-2xl mb-6 bg-light transition-colors duration-300">
      <a href={`/blog/${post.id}`} class="block aspect-16/10 overflow-hidden">
        <Picture
          class="transition-transform duration-700 group-hover:scale-105 w-full h-full object-cover"
          src={image}
          alt={title}
          formats={["avif", "webp"]}
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
        />
      </a>
    </div>
  )}

  <div class="flex-1 flex flex-col">
    <div class="mb-3 flex items-center flex-wrap gap-2 text-[10px] font-bold uppercase tracking-widest text-text/60">
      {authors && authors[0] && (
        <a href={`/authors/${slugify(authors[0])}`} class="hover:text-primary transition-colors">
          {authors[0]}
        </a>
      )}
      <span class="opacity-30">/</span>
      <span>{dateFormat(date!)}</span>
      <span class="opacity-30">/</span>
      {categories && categories[0] && (
        <a href={`/categories/${slugify(categories[0])}`} class="text-primary hover:opacity-80 transition-colors">
          {categories[0]}
        </a>
      )}
    </div>

    <h3 class="mb-4 text-2xl font-bold leading-tight group-hover:text-primary transition-colors duration-300 line-clamp-2">
      <a href={`/blog/${post.id}`}>
        {title}
      </a>
    </h3>

    <p class="text-text line-clamp-2 text-sm leading-relaxed mb-6">
      {summary ? summary : plainify(post.body ?? "").slice(0, 100)}
    </p>
    
    <div class="mt-auto pt-2">
      <a href={`/blog/${post.id}`} class="text-xs font-bold uppercase tracking-widest text-text-dark dark:text-text-light hover:text-primary transition-colors inline-flex items-center gap-2">
        Read Story <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</div>
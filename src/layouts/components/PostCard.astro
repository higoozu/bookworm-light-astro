---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import { BiCalendarEdit } from "react-icons/bi";

// 获取所有作者信息用于匹配头像
const authors = await getSinglePage("authors");

const { post } = Astro.props;
const { title, image, date, summary } = post.data;

// 匹配当前文章的作者
const postAuthors = authors.filter((author) =>
  post.data.authors
    .map((auth: string) => slugify(auth))
    .includes(slugify(author.data.title)),
);
---

<div class="h-full group">
  {
    image && (
      <div class="overflow-hidden rounded-2xl mb-6">
        {" "}
        <a href={`/blog/${post.id}`} class="block aspect-[16/10]">
          <Image
            class="transition duration-700 group-hover:scale-105 w-full h-full object-cover"
            src={image}
            alt={title}
            width={445}
            height={280}
            format="webp"
          />
        </a>
      </div>
    )
  }

  <div class="px-1">
    <ul
      class="mb-3 flex items-center text-[10px] font-bold uppercase tracking-widest text-text/50"
    >
      <li class="flex items-center">
        {
          postAuthors.map((author, index) => (
            <>
              <a
                href={`/authors/${slugify(author.data.title)}`}
                class="flex items-center hover:text-primary font-medium"
              >
                <span class="hover:text-primary transition-colors">
                  {author.data.title}
                </span>
              </a>
              {index < postAuthors.length - 1 && <span class="mx-1">&</span>}
            </>
          ))
        }
      </li>
      <li class="ml-4 flex items-center">
        <span class="mr-2 opacity-30">•</span>
        {dateFormat(date!)}
      </li>
    </ul>

    <h3 class="mb-3 text-2xl font-bold leading-tight">
      <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors">
        {title}
      </a>
    </h3>

    <p class="text-text line-clamp-2">
      {summary ? summary : plainify(post.body ?? "").slice(0, 100)}
    </p>
  </div>
</div>

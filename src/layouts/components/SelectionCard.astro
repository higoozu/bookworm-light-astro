---
import { Image } from "astro:assets";
import dateFormat from "@/lib/utils/dateFormat";

const { post } = Astro.props;
const { title, image, date } = post.data;
---

<div class="relative group overflow-hidden h-[450px] md:h-[350px] shadow-lg">
  {image && (
    <a href={`/blog/${post.id}`} class="block h-full w-full">
      <Image
        src={image}
        alt={title}
        width={800}
        height={600}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
    </a>
  )}

  <div class="absolute bottom-0 left-0 p-8 w-full pointer-events-none">
    <div class="max-w-prose">
      <p class="text-white/80 text-sm font-medium tracking-widest uppercase italic mb-3">
        {dateFormat(date!)}
      </p>
      <h2 class="text-white h2 leading-tight transition-colors group-hover:text-primary">
        <a href={`/blog/${post.id}`} class="pointer-events-auto">
          {title}
        </a>
      </h2>
    </div>
  </div>
</div>
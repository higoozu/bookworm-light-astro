---
// src/layouts/components/SelectionCard.astro
import { Image } from "astro:assets";
import dateFormat from "@/lib/utils/dateFormat";

const { post } = Astro.props;
const { title, image, date } = post.data;
---

<div class="relative group overflow-hidden h-[450px] rounded-[2rem]">
  {image && (
    <a href={`/blog/${post.id}`} class="block h-full w-full">
      <Image
        src={image}
        alt={title}
        width={600}
        height={800}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
    </a>
  )}

  <div class="absolute bottom-0 left-0 p-8 w-full pointer-events-none">
    <p class="text-white/60 text-[10px] font-bold tracking-widest uppercase mb-3">
      {dateFormat(date!)}
    </p>
    <h2 class="text-white text-2xl font-bold leading-tight group-hover:text-primary transition-colors">
      <a href={`/blog/${post.id}`} class="pointer-events-auto font-serif italic">
        {title}
      </a>
    </h2>
  </div>
</div>
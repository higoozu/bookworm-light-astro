---
// src/layouts/components/SelectionCard.astro
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import dateFormat from "@/lib/utils/dateFormat";

type Props = {
  post: CollectionEntry<"posts">;
  className?: string;
};

const { post, className = "" } = Astro.props as Props;
const { title, image, date } = post.data;
const href = `/blog/${post.id}/`;
---

<div class={className}>
  <article class="relative group overflow-hidden h-112.5 rounded-3xl bg-light transition-all duration-300">
    {image && (
      <a href={href} class="block h-full w-full">
        <Picture
          src={image}
          alt={title}
          formats={["avif", "webp"]}
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>
      </a>
    )}

    <div class="absolute bottom-0 left-0 p-8 w-full pointer-events-none transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
      {date && (
        <p class="text-neutral-200 text-[0.7em] font-bold tracking-[0.2em] uppercase mb-3">
          {dateFormat(date)}
        </p>
      )}
      <h2 class="text-neutral-50 text-2xl font-bold leading-tight group-hover:text-primary transition-colors drop-shadow-md">
        <a href={href} class="pointer-events-auto font-serif italic">
          {title}
        </a>
      </h2>
    </div>
  </article>
</div>

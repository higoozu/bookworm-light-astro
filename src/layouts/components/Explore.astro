---
// src/layouts/components/Explore.astro
const { items } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
  {items.map((item: any) => (
    <a href={item.link} class="relative group aspect-square overflow-hidden block rounded-lg">
      <img 
        src={item.image} 
        alt={item.name} 
        class="w-full h-full object-cover transition duration-700 group-hover:scale-110" 
      />
      <div class="absolute inset-0 bg-black/40 flex items-center justify-center transition-all duration-300 group-hover:bg-black/20">
        <span class="text-white dark:text-dark text-base font-bold tracking-[0.2em] uppercase group-hover:border-white transition-colors">
          {item.name}
        </span>
      </div>
    </a>
  ))}
</div>
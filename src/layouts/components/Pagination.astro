---
const { section, currentPage, totalPages } = Astro.props;
const nextPage = currentPage + 1;
const hasNextPage = totalPages > currentPage;
---

{totalPages > 1 && (
  <div class="mt-16 text-center">
    <button
      id="load-more-btn"
      data-next-page={nextPage}
      data-total-pages={totalPages}
      data-section={section}
      class={`btn btn-primary px-10 py-3 mb-4 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed ${!hasNextPage ? 'hidden' : 'inline-block'}`}
    >
      Load More
    </button>
    
    <p class="text-text/50 text-xs uppercase tracking-[0.2em] font-bold transition-opacity duration-300">
      Page <span id="current-page-display">{currentPage}</span> of {totalPages}
    </p>
  </div>
)}

<script>
  function setupLoadMore() {
    const btn = document.getElementById('load-more-btn') as HTMLButtonElement;
    const display = document.getElementById('current-page-display');
    const container = document.getElementById('post-container');

    // Prevent multiple initializations if already setup
    if (!btn || !container || !display || btn.hasAttribute('data-initialized')) return;
    btn.setAttribute('data-initialized', 'true');

    btn.onclick = async () => {
      const next = btn.getAttribute('data-next-page');
      const total = btn.getAttribute('data-total-pages');
      const sec = btn.getAttribute('data-section');
      
      if (!next || !total) return;

      const originalText = btn.innerText;
      btn.innerText = "Loading...";
      btn.disabled = true;
      btn.classList.add("animate-pulse");

      // Construct URL: Handle root sections vs nested sections
      // If section starts with '/', append '/page/X'. If not, prepend '/'.
      // For tags: section="/tags/mytag" -> "/tags/mytag/page/2"
      const baseUrl = sec ? (sec.startsWith('/') ? sec : `/${sec}`) : '';
      const url = `${baseUrl}/page/${next}/`;
      
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`Failed to load: ${res.status}`);
        
        const html = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newPosts = doc.getElementById('post-container');
        
        if (newPosts) {
          // Append new content with a simple fade-in effect could be added via CSS, 
          // but for now just inserting HTML is standard.
          container.insertAdjacentHTML('beforeend', newPosts.innerHTML);
          display.innerText = next;
          
          const nextVal = parseInt(next);
          const totalVal = parseInt(total);
          
          if (nextVal >= totalVal) {
            btn.style.display = 'none'; // Hide button
            btn.remove(); // Remove from DOM
          } else {
            btn.setAttribute('data-next-page', (nextVal + 1).toString());
            btn.innerText = originalText;
            btn.disabled = false;
            btn.classList.remove("animate-pulse");
          }
        } else {
            throw new Error("No post container found in response");
        }
      } catch (e) {
        console.error("Pagination Error:", e);
        btn.innerText = "Retry";
        btn.disabled = false;
        btn.classList.remove("animate-pulse");
      }
    };
  }

  // Init
  setupLoadMore();
  document.addEventListener('astro:page-load', setupLoadMore);
</script>
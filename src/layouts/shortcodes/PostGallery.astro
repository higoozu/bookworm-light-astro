---
import { Picture } from "astro:assets";

interface Props {
  images: {
    src: ImageMetadata;
    alt: string;
  }[];
}

const { images } = Astro.props;
---

<div class="my-10 w-screen -ml-[calc(50vw-50%)] md:w-full md:ml-0">
  <!-- Mobile: Horizontal Scroll (Fixed Height) -->
  <div class="flex md:hidden overflow-x-auto snap-x scroll-smooth no-scrollbar h-72 gap-3">
    {images.map((img) => (
      <div class="snap-center shrink-0 h-full">
        <Picture
          src={img.src}
          alt={img.alt}
          formats={["avif", "webp"]}
          height={600}
          class="h-full w-auto max-w-none rounded-none object-contain"
        />
      </div>
    ))}
  </div>

  <!-- Desktop: Masonry (Waterfall) -->
  <div class="hidden md:block columns-2 xl:columns-3 gap-4 space-y-4">
    {images.map((img) => (
      <div class="break-inside-avoid">
        <Picture
          src={img.src}
          alt={img.alt}
          formats={["avif", "webp"]}
          widths={[400, 600]}
          class="w-full h-auto rounded-lg"
        />
      </div>
    ))}
  </div>
</div>

---
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  style?: "standard" | "wide";
}

const { src, alt, caption, style = "standard" } = Astro.props;

// Mobile: Break out of container padding (-mx-4)
// Desktop Standard: Contain (w-full)
// Desktop Wide: Break out (w-[120%] -ml-[10%])
const containerClass =
  style === "wide"
    ? "w-[calc(100%+2rem)] -ml-4 md:w-full md:ml-0 lg:w-[1100px] lg:relative lg:left-1/2 lg:-translate-x-1/2 my-8"
    : "w-[calc(100%+2rem)] -ml-4 md:w-full md:ml-0 my-8";

// Mobile: No rounded corners (rounded-none)
// Desktop: Rounded corners (md:rounded-lg)
// No shadow/border as requested
const imageClass = "w-full h-auto md:rounded-lg";
---

<figure class={containerClass}>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[720, 1100, 1600]}
    sizes={style === "wide" ? "(max-width: 768px) 100vw, 1100px" : "(max-width: 768px) 100vw, 720px"}
    class={imageClass}
  />
  {caption && (
    <figcaption class="text-right text-sm text-text/60 mt-2 italic font-serif px-4 md:px-0">
      {caption}
    </figcaption>
  )}
</figure>

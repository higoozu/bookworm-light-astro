---
interface Props {
  avifSrc?: string;
  webpSrc?: string;
  fallbackSrc: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  style?: "standard" | "wide";
  class?: string;
}

const {
  avifSrc,
  webpSrc,
  fallbackSrc,
  alt,
  width,
  height,
  caption,
  style = "standard",
  class: className,
} = Astro.props;

// Mobile: Break out of container padding (-mx-4)
// Desktop Standard: Contain (w-full)
// Desktop Wide: Break out (w-[120%] -ml-[10%])
const containerClass =
  style === "wide"
    ? "w-[calc(100%+2rem)] -ml-4 md:w-[1100px] md:relative md:left-1/2 md:-translate-x-1/2 my-8"
    : "w-[calc(100%+2rem)] -ml-4 md:w-full md:ml-0 my-8";

// Mobile: No rounded corners (rounded-none)
// Desktop: Rounded corners (md:rounded-lg)
const imageClass = "w-full h-auto md:rounded-lg";
---

<figure class:list={[containerClass, className]}>
  <picture>
    {avifSrc && <source srcset={avifSrc} type="image/avif" />}
    {webpSrc && <source srcset={webpSrc} type="image/webp" />}
    <img
      src={fallbackSrc}
      alt={alt}
      width={width}
      height={height}
      class={imageClass}
      loading="lazy"
      decoding="async"
    />
  </picture>
  {caption && (
    <figcaption class="text-right text-sm text-text/60 mt-2 italic font-serif px-4 md:px-0">
      {caption}
    </figcaption>
  )}
</figure>

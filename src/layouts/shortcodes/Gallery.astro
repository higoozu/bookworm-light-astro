---
import { Picture } from "astro:assets";

interface Props {
  images: {
    src: ImageMetadata;
    alt: string;
  }[];
}

const { images } = Astro.props;
---

<div class="my-10">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 overflow-x-auto sm:overflow-visible snap-x sm:snap-none">
    {images.map((img) => (
      <div class="snap-center shrink-0 w-[85%] sm:w-auto first:pl-0 sm:first:pl-0">
        <Picture
          src={img.src}
          alt={img.alt}
          formats={["avif", "webp"]}
          widths={[400, 600]}
          sizes="(max-width: 640px) 85vw, 33vw"
          class="w-full h-full object-cover aspect-[4/3] rounded-lg shadow-sm"
        />
      </div>
    ))}
  </div>
</div>
---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string | ImageMetadata;
  og_image?: string | ImageMetadata;
  twitter_image?: string | ImageMetadata;
  image_alt?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article" | "profile";
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  authorNames?: string[];
  section?: string;
  tags?: string[];
  structuredData?: Record<string, any> | Array<Record<string, any>>;
  noFooter?: boolean;
  pagefind?: boolean;
}

// distructure frontmatters
const {
  title,
  meta_title,
  description,
  image,
  og_image,
  twitter_image,
  image_alt,
  noindex,
  canonical,
  ogType,
  publishedTime,
  modifiedTime,
  authorNames,
  section,
  tags,
  structuredData,
  noFooter,
} = Astro.props;
const { pagefind } = Astro.props;

const pageMetaOverrides = config.metadata?.page_meta?.[Astro.url.pathname];

const rawTitle =
  meta_title ||
  title ||
  pageMetaOverrides?.title ||
  config.site.title;

const baseTitle = config.site.title;
const titleTemplate =
  config.metadata?.title_template || "%s | " + baseTitle;
const pageTitle =
  rawTitle === baseTitle
    ? baseTitle
    : titleTemplate.replace("%s", rawTitle).replace("%site", baseTitle);

const metaDescription = plainify(
  description ||
    pageMetaOverrides?.description ||
    config.metadata.meta_description
);

const resolveImageUrl = (value?: string | ImageMetadata) => {
  if (!value) return undefined;
  if (typeof value === "string") return value;
  if (typeof value === "object" && "src" in value) return value.src;
  return undefined;
};

const resolveAbsoluteUrl = (value?: string) => {
  if (!value) return undefined;
  if (value.startsWith("http://") || value.startsWith("https://")) {
    return value;
  }
  const normalized = value.startsWith("/") ? value : `/${value}`;
  return new URL(normalized, config.site.base_url).toString();
};

const canonicalUrl = canonical
  ? resolveAbsoluteUrl(canonical)
  : new URL(Astro.url.pathname, config.site.base_url).toString();

const ogImageCandidate =
  resolveImageUrl(og_image) ||
  pageMetaOverrides?.og_image ||
  resolveImageUrl(image) ||
  config.metadata.meta_image;

const twitterImageCandidate =
  resolveImageUrl(twitter_image) ||
  resolveImageUrl(og_image) ||
  resolveImageUrl(image) ||
  config.metadata.meta_image;

const ogImageUrl = resolveAbsoluteUrl(ogImageCandidate);
const twitterImageUrl = resolveAbsoluteUrl(twitterImageCandidate);

const imageAltText = image_alt || plainify(pageTitle);

const ogTypeValue = ogType || pageMetaOverrides?.og_type || "website";

const toIsoString = (value?: string | Date) => {
  if (!value) return undefined;
  return value instanceof Date ? value.toISOString() : value;
};

const publishedTimeValue = toIsoString(publishedTime);
const modifiedTimeValue = toIsoString(modifiedTime);

const publisherLogo =
  resolveAbsoluteUrl(config.site.logo_public || config.site.favicon);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.site.title,
  url: config.site.base_url,
  description: config.metadata.meta_description,
  inLanguage: config.site.language || "en",
  potentialAction: {
    "@type": "SearchAction",
    target: `${config.site.base_url}/search/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: metaDescription,
  url: canonicalUrl,
  inLanguage: config.site.language || "en",
  isPartOf: {
    "@type": "WebSite",
    name: config.site.title,
    url: config.site.base_url,
  },
  primaryImageOfPage: ogImageUrl
    ? {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: 1200,
        height: 630,
      }
    : undefined,
};

const articleSchema =
  ogTypeValue === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: pageTitle,
        description: metaDescription,
        datePublished: publishedTimeValue,
        dateModified: modifiedTimeValue || publishedTimeValue,
        author: (authorNames || []).map((name) => ({
          "@type": "Person",
          name,
        })),
        image: ogImageUrl ? [ogImageUrl] : undefined,
        mainEntityOfPage: canonicalUrl,
        publisher: {
          "@type": "Organization",
          name: config.site.title,
          logo: publisherLogo
            ? {
                "@type": "ImageObject",
                url: publisherLogo,
              }
            : undefined,
        },
        articleSection: section,
        keywords: tags?.join(", "),
        inLanguage: config.site.language || "en",
      }
    : null;

const jsonLdData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [websiteSchema, webPageSchema, ...(articleSchema ? [articleSchema] : [])];
---

<!doctype html>
<html lang={config.site.language || "en"}>
  <head>
    <!-- base meta -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <!-- Theme initialization script - must run before first paint -->
    <script is:inline>
      (function () {
        const getTheme = () => localStorage.getItem("theme") || "system";
        const prefersDark = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        function applyThemeToDocument(targetDocument, themeValue) {
          const htmlElement = targetDocument.documentElement;
          if (themeValue === "dark") {
            htmlElement.classList.add("dark");
          } else if (themeValue === "light") {
            htmlElement.classList.remove("dark");
          } else if (prefersDark()) {
            htmlElement.classList.add("dark");
          } else {
            htmlElement.classList.remove("dark");
          }
        }

        // Initial application
        applyThemeToDocument(document, getTheme());

        // Re-apply on View Transitions swap (prevents flash of white)
        document.addEventListener("astro:after-swap", () => {
          applyThemeToDocument(document, getTheme());
        });

        // Ensure the incoming document has the right theme before swap
        document.addEventListener("astro:before-swap", (event) => {
          const nextDocument =
            event.newDocument || event.detail?.newDocument;
          if (nextDocument) {
            applyThemeToDocument(nextDocument, getTheme());
          }
        });
      })();
    </script>

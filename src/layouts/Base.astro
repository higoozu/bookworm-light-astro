      })();
    </script> -->
    <title>{plainify(pageTitle)}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={config.site.title} />
    <meta name="color-scheme" content="light dark" />

    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={config.metadata.theme_color_light || "#F7F7F7"}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={config.metadata.theme_color_dark || "#051F18"}
    />
    <!-- icons -->
    <link rel="icon" href={config.site.favicon} />
    <link rel="icon" type="image/png" sizes="16x16" href={config.site.icon_16} />
    <link rel="icon" type="image/png" sizes="32x32" href={config.site.icon_32} />
    <link rel="apple-touch-icon" sizes="180x180" href={config.site.apple_touch_icon} />
    <link rel="manifest" href={config.site.manifest} />
    {config.site.mask_icon && (
      <link rel="mask-icon" href={config.site.mask_icon} color={config.metadata.theme_color_dark || "#1B8A62"} />
    )}

    <!-- SEO meta -->
    <link rel="canonical" href={canonicalUrl} item-prop="url" />
    {config.metadata.sitemap_path && (
      <link
        rel="sitemap"
        type="application/xml"
        href={resolveAbsoluteUrl(config.metadata.sitemap_path)}
      />
    )}
    <meta name="description" content={metaDescription} />
    <meta name="author" content={config.metadata.meta_author} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex,nofollow"
          : config.metadata.default_robots || "index,follow"
      }
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- mobile -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={config.site.title} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph -->
    <meta property="og:title" content={plainify(pageTitle)} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogTypeValue} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.site.site_name || config.site.title} />
    <meta property="og:locale" content={config.site.locale || "en_US"} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={imageAltText} />}
    {publishedTimeValue && ogTypeValue === "article" && (
      <meta property="article:published_time" content={publishedTimeValue} />
    )}
    {modifiedTimeValue && ogTypeValue === "article" && (
      <meta property="article:modified_time" content={modifiedTimeValue} />
    )}
    {section && ogTypeValue === "article" && (
      <meta property="article:section" content={section} />
    )}
    {(tags || []).map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    {config.metadata.twitter_handle && (
      <meta name="twitter:site" content={config.metadata.twitter_handle} />
    )}
    {config.metadata.twitter_creator && (
      <meta name="twitter:creator" content={config.metadata.twitter_creator} />
    )}
    <meta name="twitter:title" content={plainify(pageTitle)} />
    <meta name="twitter:description" content={metaDescription} />
    {twitterImageUrl && <meta name="twitter:image" content={twitterImageUrl} />}
    {twitterImageUrl && (
      <meta name="twitter:image:alt" content={imageAltText} />
    )}

    <!-- performance hints -->
    {(config.metadata.resource_hints?.preconnect || []).map((href) => (
      <link rel="preconnect" href={href} crossorigin />
    ))}
    {(config.metadata.resource_hints?.dns_prefetch || []).map((href) => (
      <link rel="dns-prefetch" href={href} />
    ))}

    <!-- structured data -->
    <script type="application/ld+json">
      {JSON.stringify(jsonLdData)}
    </script>

    <ClientRouter />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main
      id="main-content"
      class="min-h-[60vh] bg-body dark:bg-body transition-colors"
      data-pagefind-body={pagefind !== false ? true : undefined}
    >
      <slot />
    </main>
    {!noFooter && <Footer />}
  </body>
</html>

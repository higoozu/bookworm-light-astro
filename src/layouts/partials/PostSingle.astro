---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Picture } from "astro:assets";
import { render } from "astro:content";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } = post.data;

const postAuthors = allAuthors.filter((author) =>
  authors
    .map((author: string) => slugify(author))
    .includes(slugify(author.data.title)),
);
---

<section class="section pt-16 md:pt-24">
  <div class="container">
    <article>
      <!-- Header -->
      <header class="text-center max-w-4xl mx-auto mb-12 md:mb-16">
        <div class="flex items-center justify-center gap-3 mb-6">
          {categories.map((category: string) => (
            <a
              href={`/categories/${slugify(category)}`}
              class="text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-text-dark dark:hover:text-text-light transition-colors"
            >
              {humanize(category)}
            </a>
          ))}
        </div>

        <h1
          set:html={markdownify(title)}
          class="h1 font-serif italic font-bold text-4xl md:text-6xl text-text-dark dark:text-text-light mb-10 leading-[1.1]"
        />

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm font-medium text-text/80">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-3">
              {postAuthors.map((author) => (
                <div class="w-10 h-10 rounded-full border-2 border-white dark:border-dark overflow-hidden bg-light">
                  {author.data.image ? (
                    <Picture
                      src={author.data.image}
                      alt={author.data.title}
                      formats={['avif', 'webp']}
                      widths={[40, 80]}
                      sizes="40px"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-primary/10 text-primary font-bold">
                      {author.data.title[0]}
                    </div>
                  )}
                </div>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-1 text-left sm:text-center">
              <span>By</span>
              <span class="text-text-dark dark:text-text-light font-bold">
                {postAuthors.map((a, i) => (
                  <a href={`/authors/${slugify(a.id)}`} class="hover:text-primary transition-colors">
                    {a.data.title}{i < postAuthors.length - 1 && ","}
                  </a>
                ))}
              </span>
            </div>
          </div>
          
          <div class="hidden sm:block w-1 h-1 rounded-full bg-text/30"></div>
          
          <div class="flex items-center gap-2">
            <span>{dateFormat(date)}</span>
          </div>
        </div>
      </header>

      <!-- Main Image -->
      {image && (
        <div class="max-w-5xl mx-auto mb-16 md:mb-20">
          <div class="rounded-2xl md:rounded-3xl overflow-hidden shadow-sm">
            <Picture
              src={image}
              alt={title}
              formats={['avif', 'webp']}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 1200px) 100vw, 1200px"
              class="w-full h-auto object-cover aspect-[16/9] md:aspect-[21/9]"
              priority
            />
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="max-w-[720px] mx-auto">
        <div class="content prose-lg prose-headings:font-serif prose-headings:font-bold prose-p:font-sans prose-p:text-lg prose-p:leading-8 prose-p:text-text-dark/90 dark:prose-p:text-text-light/90">
          <Content />
        </div>

        <!-- Footer: Tags & Share -->
        <div class="mt-16 pt-8 border-t border-border dark:border-border flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <a
                href={`/tags/${slugify(tag)}`}
                class="inline-block px-4 py-1.5 rounded-full bg-light text-xs font-bold uppercase tracking-wider text-text/80 hover:bg-primary hover:text-white transition-colors duration-300"
              >
                #{humanize(tag)}
              </a>
            ))}
          </div>
          <Share
            className="social-share"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>
      </div>
    </article>
  </div>
</section>

{similarPosts.length > 0 && (
  <section class="section pt-12 border-t border-border dark:border-border mt-20">
    <div class="container">
      <h2 class="mb-12 text-center h3 font-serif italic">Read Next</h2>
      <SimilarPosts posts={similarPosts.slice(0, 3)} />
    </div>
  </section>
)}
---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import AuthorCard from "@/layouts/components/AuthorCard.astro";
import Comments from "@/layouts/components/Comments.astro";
import SelectionCard from "@/layouts/components/SelectionCard.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Picture } from "astro:assets";
import { render } from "astro:content";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.id);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } = post.data;

const postAuthors = allAuthors.filter((author) =>
  authors
    .map((author: string) => slugify(author))
    .includes(slugify(author.data.title)),
);
const sortedPosts = sortByDate(posts);
const selectionPosts = sortedPosts
  .filter((post) => post.data.selection === true)
  .slice(0, 3);
---

<section class="section pt-16 md:pt-24">
  <div class="container px-4 md:px-8">
    <article>
      <!-- Header -->
      <header class="text-center max-w-4xl mx-auto mb-12 md:mb-16 px-4 md:px-0">
        <div class="flex items-center justify-center gap-3 mb-6">
          {categories.map((category: string) => (
            <a
              href={`/categories/${slugify(category)}/`}
              class="text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-text-dark dark:hover:text-text-light transition-colors"
            >
              {humanize(category)}
            </a>
          ))}
        </div>

        <h1
          set:html={markdownify(title)}
          class="font-display italic font-bold text-4xl md:text-6xl text-text-dark dark:text-text-light mb-10 leading-[1.1]"
        />

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm font-medium text-text/80">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-3">
              {postAuthors.map((author) => (
                <div class="w-10 h-10 rounded-full border-2 border-white dark:border-dark overflow-hidden bg-light">
                  {author.data.image ? (
                    <Picture
                      src={author.data.image}
                      alt={author.data.title}
                      formats={['avif', 'webp']}
                      widths={[40, 80]}
                      sizes="40px"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-primary/10 text-primary font-bold">
                      {author.data.title[0]}
                    </div>
                  )}
                </div>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-1 text-left sm:text-center">
              <span>By</span>
              <span class="text-text-dark dark:text-text-light font-bold">
                {postAuthors.map((a, i) => (
                  <a href={`/authors/${slugify(a.id)}/`} class="hover:text-primary transition-colors">
                    {a.data.title}{i < postAuthors.length - 1 && ","}
                  </a>
                ))}
              </span>
            </div>
          </div>
          
          <div class="hidden sm:block w-1 h-1 rounded-full bg-text/30"></div>
          
          <div class="flex items-center gap-2">
            <span>{dateFormat(date)}</span>
          </div>
        </div>
      </header>

      <!-- Main Image -->
      {image && (
        <div class="max-w-340 mx-auto px-4 mb-16 md:mb-20">
          <div class="relative -mx-4 sm:-mx-6 md:-mx-6 lg:-mx-10">
            <div class="w-[calc(100%+2rem)] -ml-4 md:w-full md:ml-0 rounded-none md:rounded-4xl overflow-hidden">
              <Picture
                src={image}
                alt={title}
                formats={["avif", "webp"]}
                widths={[900, 1400, 2000]}
                sizes="(max-width: 767px) 100vw, (max-width: 1200px) 90vw, 1400px"
                class="w-full h-auto object-cover aspect-video md:aspect-21/9"
                priority
              />
            </div>
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="max-w-180 mx-auto">
        <div class="content">
          <Content />
        </div>

        <!-- Footer: Author Card + Tags & Share -->
        <div class="mt-16">
          {postAuthors.length > 0 && (
            <>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-text/60">About the Author</span>
              </div>

              <div class="flex flex-col gap-6">
                {postAuthors.map((author) => (
                  <AuthorCard author={author} />
                ))}
              </div>
            </>
          )}

          <div class="mt-10 pt-8">
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <a
                  href={`/tags/${slugify(tag)}/`}
                  class="inline-block px-4 py-1.5 rounded-full border border-border text-xs uppercase tracking-wider text-text/80 hover:border-primary hover:text-primary transition-colors duration-300"
                >
                  #{humanize(tag)}
                </a>
              ))}
            </div>
            
            <!-- Comment & Share Section -->
            <Comments postId={post.id} className="mt-6">
              <Share
                slot="share"
                className="post-share-trigger-wrap"
                title={title}
                description={description}
                slug={post.id}
                showCopy={true}
              />
            </Comments>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

{similarPosts.length > 0 && (
  <section class="section pt-12 mt-20">
    <div class="container">
      <h2 class="mb-12 text-center h3 font-ui">Read Next</h2>
      <SimilarPosts posts={similarPosts.slice(0, 3)} />
    </div>
  </section>
)}

<section class="bg-section-bg dark:bg-section-bg rounded-4xl my-12 pt-16 pb-5 md:py-24 transition-colors">
    <div class="container">
      <div class="flex justify-start mb-16 px-2 md:px-0">
        <div class="inline-block bg-badge-bg dark:bg-badge-bg rounded-full px-6 py-2 shadow-sm">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] m-0 text-badge-text dark:text-badge-text">Editor's Selection</h2>
        </div>
      </div>
      <div class="row gx-4">
        {selectionPosts.map((post) => (
          <SelectionCard post={post} className="col-12 md:col-4 mb-8 md:mb-0 last:mb-0" />
        ))}
      </div>
    </div>
  </section>

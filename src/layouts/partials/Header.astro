---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";
import { IoSearch, IoSunny, IoMoon, IoInvertMode, IoMenu, IoClose } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { pathname } = Astro.url;
---

<!-- Header Spacer to prevent content overlap -->
<div class="header-spacer h-16 md:h-20"></div>

<header
  id="main-header"
  class="absolute top-0 left-0 w-full z-50 will-change-transform font-ui"
>
  <div class="container mx-auto px-4 h-16 md:h-20 flex items-center justify-between">
    <!-- Logo -->
    <div class="shrink-0 z-60 relative">
      <Logo />
    </div>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-6">
        {
          main.map((menu) => (
            <li class="relative group" data-dropdown="menu">
              {menu.hasChildren ? (
                <>
                  <button
                    type="button"
                    class="flex items-center gap-1 py-2 text-lg font-medium text-text-dark dark:text-text-light hover:text-primary dark:hover:text-primary transition-colors"
                    aria-expanded="false"
                    data-dropdown-toggle
                  >
                    {menu.name}
                    <svg class="h-4 w-4 fill-current opacity-70 group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 20 20">
                      <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                    </svg>
                  </button>
                  <ul
                    class="absolute top-full left-0 min-w-50 bg-white dark:bg-body rounded-lg shadow-lg border border-border dark:border-border opacity-0 invisible pointer-events-none transition-all duration-200 transform translate-y-2 p-2 before:content-[''] before:absolute before:-top-2 before:left-0 before:h-2 before:w-full before:pointer-events-auto"
                    data-dropdown-panel
                  >
                    {menu.children?.map((child) => (
                      <li>
                        <a
                          href={child.url}
                          class={`block px-4 py-2 hover:text-primary dark:hover:text-primary rounded-md transition-colors ${
                            pathname === child.url || pathname === `${child.url}/`
                              ? "text-primary font-semibold"
                              : "text-text-dark dark:text-text-light"
                          }`}
                        >
                          {child.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={menu.url}
                  class={`block py-2 text-lg transition-colors ${
                    pathname === menu.url || pathname === `${menu.url}/`
                      ? "text-primary"
                      : "text-text-dark dark:text-text-light hover:text-primary dark:hover:text-primary"
                  }`}
                >
                  {menu.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Desktop Controls -->
    <div class="hidden md:flex items-center gap-4">
      <!-- Search -->
      <a
        href="/search/"
        class="p-2 text-xl text-text-dark dark:text-text-light hover:text-primary dark:hover:text-primary transition-colors"
        aria-label="Search"
      >
        <IoSearch />
      </a>

      <!-- Theme Switcher -->
      <div class="relative group" data-dropdown="theme">
        <button
          type="button"
          class="p-2 text-xl text-text-dark dark:text-text-light hover:text-primary dark:hover:text-primary transition-colors cursor-pointer"
          aria-label="Toggle Theme"
          aria-expanded="false"
          data-dropdown-toggle
        >
          <span class="theme-icon-display">
            <span class="theme-icon-light hidden"><IoSunny /></span>
            <span class="theme-icon-dark hidden"><IoMoon /></span>
            <span class="theme-icon-system hidden"><IoInvertMode /></span>
          </span>
        </button>
        <!-- Theme Dropdown -->
        <div
          class="absolute right-0 top-full mt-2 w-32 bg-white dark:bg-body rounded-lg shadow-lg border border-border dark:border-border opacity-0 invisible pointer-events-none transition-all duration-200 transform translate-y-2 overflow-hidden before:content-[''] before:absolute before:-top-2 before:left-0 before:h-2 before:w-full before:pointer-events-auto"
          data-dropdown-panel
        >
            <button class="theme-btn w-full text-left px-4 py-2 flex items-center gap-2 text-text-dark dark:text-text-light cursor-pointer data-[active=true]:text-primary data-[active=true]:font-semibold transition-colors" data-theme="light">
                <IoSunny className="text-sm" /> <span>Light</span>
            </button>
            <button class="theme-btn w-full text-left px-4 py-2 flex items-center gap-2 text-text-dark dark:text-text-light cursor-pointer data-[active=true]:text-primary data-[active=true]:font-semibold transition-colors" data-theme="dark">
                <IoMoon className="text-sm" /> <span>Dark</span>
            </button>
            <button class="theme-btn w-full text-left px-4 py-2 flex items-center gap-2 text-text-dark dark:text-text-light cursor-pointer data-[active=true]:text-primary data-[active=true]:font-semibold transition-colors" data-theme="system">
                <IoInvertMode className="text-sm" /> <span>System</span>
            </button>
        </div>
      </div>
    </div>

    <!-- Mobile Controls -->
    <div class="flex md:hidden items-center gap-3 z-60 relative">
      <a
        href="/search/"
        class="p-2 text-2xl text-text-dark dark:text-text-light transition-colors"
        aria-label="Search"
      >
        <IoSearch />
      </a>
      <button
        id="mobile-menu-toggle"
        class="p-2 text-3xl text-text-dark dark:text-text-light transition-colors focus:outline-none"
        aria-label="Toggle Menu"
      >
        <span class="icon-menu block"><IoMenu /></span>
        <span class="icon-close hidden"><IoClose /></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-overlay"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 invisible transition-all duration-300 md:hidden"
  >
  </div>

  <!-- Mobile Menu Sidebar -->
  <div
    id="mobile-menu"
    class="fixed top-0 right-0 h-dvh w-full bg-white/98 dark:bg-body/98 backdrop-blur-md z-50 transform translate-x-full opacity-0 invisible transition-all duration-300 md:hidden flex flex-col pt-20 overscroll-contain"
  >
    <div class="flex-1 overflow-y-auto py-6 px-6">
      <ul class="space-y-4">
        {
          main.map((menu) => (
            <li class="border-b border-border dark:border-border pb-4 last:border-0">
              {menu.hasChildren ? (
                <details class="group">
                  <summary class="flex items-center justify-between text-xl font-medium text-text-dark dark:text-text-light cursor-pointer list-none">
                    {menu.name}
                    <svg class="h-5 w-5 fill-current transform group-open:rotate-180 transition-transform duration-300" viewBox="0 20 20">
                      <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                    </svg>
                  </summary>
                  <ul class="mt-4 ml-4 space-y-3">
                    {menu.children?.map((child) => (
                      <li>
                        <a
                          href={child.url}
                          class={`mobile-nav-link block text-lg transition-colors ${
                            pathname === child.url || pathname === child.url.replace(/\/$/, "")
                              ? "text-primary font-medium"
                              : "text-text-dark/80 dark:text-text-light/80 hover:text-primary dark:hover:text-primary"
                          }`}
                        >
                          {child.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={menu.url}
                  class={`mobile-nav-link block text-xl font-medium ${
                    pathname === menu.url || pathname === menu.url.replace(/\/$/, "")
                      ? "text-primary"
                      : "text-text-dark dark:text-text-light"
                  }`}
                >
                  {menu.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Mobile Theme Switcher -->
    <div class="border-t border-border dark:border-border p-6 bg-dark/5">
        <p class="text-sm text-text-dark/60 dark:text-text-light/60 mb-3 uppercase font-semibold tracking-wider">Switch Theme</p>
        <div class="flex items-center gap-4">
            <button class="theme-btn-mobile flex-1 flex flex-col items-center gap-2 p-3 rounded-lg border border-border dark:border-border bg-white dark:bg-body text-text-dark dark:text-text-light data-[active=true]:border-primary data-[active=true]:text-primary transition-all" data-theme="light">
                <IoSunny className="text-xl" />
                <span class="text-xs font-medium">Light</span>
            </button>
            <button class="theme-btn-mobile flex-1 flex flex-col items-center gap-2 p-3 rounded-lg border border-border dark:border-border bg-white dark:bg-body text-text-dark dark:text-text-light data-[active=true]:border-primary data-[active=true]:text-primary transition-all" data-theme="dark">
                <IoMoon className="text-xl" />
                <span class="text-xs font-medium">Dark</span>
            </button>
            <button class="theme-btn-mobile flex-1 flex flex-col items-center gap-2 p-3 rounded-lg border border-border dark:border-border bg-white dark:bg-body text-text-dark dark:text-text-light data-[active=true]:border-primary data-[active=true]:text-primary transition-all" data-theme="system">
                <IoInvertMode className="text-xl" />
                <span class="text-xs font-medium">System</span>
            </button>
        </div>
    </div>
  </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        new NavbarController();
        new DesktopDropdownController();
        initTheme();
    });

    /**
     * Navbar Controller
     * Handles scroll interactions using a state machine and requestAnimationFrame
     */
    class NavbarController {
        constructor() {
            this.header = document.getElementById("main-header");
            if (!this.header) return;

            this.lastScrollY = window.scrollY;
            this.headerHeight = this.header.offsetHeight || 80;
            this.isMenuOpen = false;
            this.ticking = false;

            // Styles
            this.classes = {
                fixed: ["fixed", "-translate-y-full"], // Hidden state
                visible: ["translate-y-0"], // Visible modifier
                absolute: ["absolute", "translate-y-0"], // Top state
                styled: ["bg-white/90", "backdrop-blur-md", "dark:bg-body/90", "border-b", "border-border", "dark:border-border"],
                transparent: ["border-transparent", "border-b"],
                animating: ["transition-transform", "duration-300"]
            };

            // Bind methods
            this.onScroll = this.onScroll.bind(this);
            this.toggleMenu = this.toggleMenu.bind(this);
            
            // Listeners
            window.addEventListener("scroll", this.onScroll, { passive: true });
            
            // Mobile Menu
            this.mobileToggle = document.getElementById("mobile-menu-toggle");
            this.mobileToggle?.addEventListener("click", () => this.toggleMenu());
            
            this.mobileOverlay = document.getElementById("mobile-overlay");
            this.mobileOverlay?.addEventListener("click", () => this.toggleMenu(false));

            // Init state
            this.update();
        }

        onScroll() {
            if (!this.ticking) {
                window.requestAnimationFrame(() => {
                    this.update();
                    this.ticking = false;
                });
                this.ticking = true;
            }
        }

        update() {
            if (this.isMenuOpen) return;

            const currentScrollY = window.scrollY;
            const scrollDiff = currentScrollY - this.lastScrollY;
            const isScrollingDown = scrollDiff > 0;

            // --- State Machine ---

            // 1. AT TOP (Reset)
            if (currentScrollY <= 0) {
                this.setTopState();
            } 
            // 2. SCROLLED DOWN
            else if (currentScrollY > this.headerHeight) {
                this.setScrolledState(isScrollingDown);
            }
            // 3. BUFFER ZONE (0 < y <= height)
            // Do nothing. Leave in previous state (usually Absolute if coming from top)
            
            this.lastScrollY = currentScrollY;
        }

        setTopState() {
            // Remove animation to prevent snapping when resetting absolute position
            this.header.classList.remove(...this.classes.animating);
            
            // Visuals: Transparent
            this.header.classList.remove(...this.classes.styled);
            this.header.classList.add(...this.classes.transparent);

            // Position: Absolute Top
            this.header.classList.remove(...this.classes.fixed);
            this.header.classList.remove("-translate-y-full"); // Ensure no hidden translate
            this.header.classList.add(...this.classes.absolute);
        }

        setScrolledState(isScrollingDown) {
            // Visuals: Styled
            this.header.classList.remove(...this.classes.transparent);
            this.header.classList.add(...this.classes.styled);

            if (isScrollingDown) {
                // --- ACTION A: HIDE ---
                // If it was Absolute: Silent Switch (No animation, just snap to hidden fixed)
                // If it was Fixed Visible: Slide Out (Animation)
                
                if (this.header.classList.contains("absolute")) {
                    this.header.classList.remove(...this.classes.animating); // Silent
                    this.header.classList.remove(...this.classes.absolute);
                    this.header.classList.add(...this.classes.fixed); // Adds -translate-y-full implied
                } else {
                    this.header.classList.add(...this.classes.animating); // Animate
                    this.header.classList.remove(...this.classes.visible);
                    this.header.classList.add(...this.classes.fixed); // Ensure it has base fixed/hidden classes
                }
            } else {
                // --- ACTION B: SHOW ---
                // Switch to Fixed Visible
                this.header.classList.add(...this.classes.animating); // Animate slide in
                this.header.classList.remove("absolute", "-translate-y-full");
                this.header.classList.add("fixed", "top-0", "translate-y-0");
            }
        }

        toggleMenu(forceState) {
            this.isMenuOpen = typeof forceState === 'boolean' ? forceState : !this.isMenuOpen;
            
            const mobileMenu = document.getElementById("mobile-menu");
            const iconMenu = this.mobileToggle?.querySelector(".icon-menu");
            const iconClose = this.mobileToggle?.querySelector(".icon-close");

            if (this.isMenuOpen) {
                // Open
                mobileMenu?.classList.remove("translate-x-full");
                mobileMenu?.classList.remove("opacity-0", "invisible");
                this.mobileOverlay?.classList.remove("opacity-0", "invisible");
                iconMenu?.classList.add("hidden");
                iconClose?.classList.remove("hidden");
                document.body.style.overflow = "hidden";

                // Fix Black BG: Force styled header
                this.header.classList.remove(...this.classes.transparent);
                this.header.classList.add(...this.classes.styled);
            } else {
                // Close
                mobileMenu?.classList.add("translate-x-full");
                mobileMenu?.classList.add("opacity-0", "invisible");
                this.mobileOverlay?.classList.add("opacity-0", "invisible");
                iconMenu?.classList.remove("hidden");
                iconClose?.classList.add("hidden");
                document.body.style.overflow = "";

                // Reset state based on scroll
                this.update(); 
            }
        }
    }

    class DesktopDropdownController {
        constructor() {
            this.activeRoot = null;
            this.closeTimers = new Map();
            this.canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
            this.onDocumentClick = this.onDocumentClick.bind(this);
            this.onKeyDown = this.onKeyDown.bind(this);

            const roots = document.querySelectorAll('[data-dropdown]');
            roots.forEach((root) => {
                const toggle = root.querySelector('[data-dropdown-toggle]');
                const panel = root.querySelector('[data-dropdown-panel]');
                if (!toggle || !panel) return;

                toggle.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (this.canHover.matches) {
                        this.clearCloseTimer(root);
                        this.open(root);
                        return;
                    }
                    this.toggle(root);
                });

                root.addEventListener('mouseenter', () => {
                    if (!this.canHover.matches) return;
                    this.clearCloseTimer(root);
                    this.open(root);
                });

                root.addEventListener('mouseleave', () => {
                    if (!this.canHover.matches) return;
                    this.setCloseTimer(root);
                });

                root.addEventListener('focusin', () => {
                    if (!this.canHover.matches) return;
                    this.clearCloseTimer(root);
                    this.open(root);
                });

                root.addEventListener('focusout', () => {
                    if (!this.canHover.matches) return;
                    this.setCloseTimer(root);
                });

                panel.addEventListener('click', (e) => {
                    if (this.canHover.matches) return;
                    const target = e.target;
                    if (!(target instanceof HTMLElement)) return;
                    if (target.closest('a, button')) this.close(root);
                });
            });

            document.addEventListener('click', this.onDocumentClick);
            document.addEventListener('keydown', this.onKeyDown);
        }

        toggle(root) {
            const isOpen = root.dataset.open === 'true';
            if (isOpen) this.close(root);
            else this.open(root);
        }

        open(root) {
            if (this.activeRoot && this.activeRoot !== root) {
                this.close(this.activeRoot);
            }
            const toggle = root.querySelector('[data-dropdown-toggle]');
            const panel = root.querySelector('[data-dropdown-panel]');
            if (!panel) return;
            root.dataset.open = 'true';
            toggle?.setAttribute('aria-expanded', 'true');
            panel.classList.remove('opacity-0', 'invisible', 'pointer-events-none', 'translate-y-2');
            this.activeRoot = root;
        }

        close(root) {
            const toggle = root.querySelector('[data-dropdown-toggle]');
            const panel = root.querySelector('[data-dropdown-panel]');
            if (!panel) return;
            root.dataset.open = 'false';
            toggle?.setAttribute('aria-expanded', 'false');
            panel.classList.add('opacity-0', 'invisible', 'pointer-events-none', 'translate-y-2');
            if (this.activeRoot === root) this.activeRoot = null;
        }

        setCloseTimer(root) {
            this.clearCloseTimer(root);
            const timer = window.setTimeout(() => this.close(root), 120);
            this.closeTimers.set(root, timer);
        }

        clearCloseTimer(root) {
            const timer = this.closeTimers.get(root);
            if (timer) window.clearTimeout(timer);
            this.closeTimers.delete(root);
        }

        onDocumentClick(e) {
            if (this.canHover.matches) return;
            if (!this.activeRoot) return;
            if (this.activeRoot.contains(e.target)) return;
            this.close(this.activeRoot);
        }

        onKeyDown(e) {
            if (e.key !== 'Escape') return;
            if (this.activeRoot) this.close(this.activeRoot);
        }
    }

    function initTheme() {
        const themeBtns = document.querySelectorAll('.theme-btn');
        const themeBtnsMobile = document.querySelectorAll('.theme-btn-mobile');
        
        const savedTheme = localStorage.getItem("theme") || "system";
        setTheme(savedTheme);
        updateThemeUI(savedTheme);

        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        mediaQuery.addEventListener('change', () => {
            if (localStorage.getItem("theme") === "system") {
                setTheme("system");
            }
        });

        [...themeBtns, ...themeBtnsMobile].forEach(btn => {
            btn.addEventListener('click', (e) => {
                const theme = (e.currentTarget as HTMLElement).dataset.theme;
                if (theme) setTheme(theme);
            });
        });

        function setTheme(theme) {
            localStorage.setItem("theme", theme);
            updateThemeUI(theme);
            const html = document.documentElement;
            if (theme === 'dark') html.classList.add('dark');
            else if (theme === 'light') html.classList.remove('dark');
            else {
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) html.classList.add('dark');
                else html.classList.remove('dark');
            }
        }

        function updateThemeUI(theme) {
            // Update active states for buttons and icons (simplified for brevity)
            [...themeBtns, ...themeBtnsMobile].forEach(btn => {
                const btnTheme = btn.dataset.theme;
                if (btnTheme === theme) btn.setAttribute('data-active', 'true');
                else btn.removeAttribute('data-active');
            });
            
            const iconLight = document.querySelector('.theme-icon-light');
            const iconDark = document.querySelector('.theme-icon-dark');
            const iconSystem = document.querySelector('.theme-icon-system');
            
            iconLight?.classList.add('hidden');
            iconDark?.classList.add('hidden');
            iconSystem?.classList.add('hidden');

            if (theme === 'light') iconLight?.classList.remove('hidden');
            else if (theme === 'dark') iconDark?.classList.remove('hidden');
            else iconSystem?.classList.remove('hidden');
        }

    }
</script>

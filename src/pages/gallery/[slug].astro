---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import Lightbox from "@/layouts/components/Lightbox";
import { Picture, getImage } from "astro:assets";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");
  return galleries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  cover,
  images,
  og_image,
  twitter_image,
  image_alt,
  canonical,
  noindex,
} = entry.data;

// Prepare images for Lightbox (max 1920px)
const lightboxImages = await Promise.all(
  (images || []).map(async (img) => {
    const optimized = await getImage({
        src: img.src,
        width: 1920,
        format: 'webp',
        quality: 90
    });
    return {
      src: optimized.src,
      alt: img.alt,
    };
  })
);
---

<Base
  title={title}
  description={description}
  image={cover}
  og_image={og_image || cover}
  twitter_image={twitter_image || cover}
  image_alt={image_alt}
  canonical={canonical}
  noindex={noindex}
>
    <!-- Hero Section -->
    <div class="relative py-20 md:py-32 flex items-center justify-center text-center overflow-hidden">
         <div class="absolute inset-0 z-0">
            <Picture 
                src={cover} 
                alt={title}
                formats={['avif', 'webp']}
                widths={[640, 1024]}
                sizes="100vw"
                class="w-full h-full object-cover opacity-50 blur-sm transform scale-105"
            />
         </div>
         <div class="absolute inset-0 z-10 bg-black/40 dark:bg-black/50"></div>
         
         <div class="relative z-20 container mx-auto px-4">
             <h1 class="font-ui font-bold text-white dark:text-dark mb-4 drop-shadow-lg">{title}</h1>
             {description && <p class="text-base md:text-lg text-white/90 dark:text-dark/90 max-w-2xl mx-auto">{description}</p>}
         </div>
    </div>

    <!-- Gallery Section -->
    <div class="section container relative">
        <div class="content mb-12 text-center max-w-3xl mx-auto prose dark:prose-invert">
            <Content />
        </div>
        
        {images && images.length > 0 ? (
            <div class="columns-2 lg:columns-3 gap-4 space-y-4">
                {images.map((img, index) => (
                    <div 
                        class="break-inside-avoid cursor-pointer overflow-hidden rounded-lg relative group mb-4 gallery-item"
                        data-index={index}
                    >
                         <Picture 
                            src={img.src} 
                            alt={img.alt || `Gallery image ${index + 1}`}
                            formats={['avif', 'webp']}
                            widths={[400, 800]}
                            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                            class="w-full h-auto object-cover transition-colors duration-300" 
                         />
                         <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 pointer-events-none"></div>
                    </div>
                ))}
            </div>
        ) : (
            <div class="text-center py-10 text-gray-500 dark:text-gray-400">
                <p>No images found in this gallery.</p>
            </div>
        )}
        
        <Lightbox client:only="react" images={lightboxImages} />
    </div>

    <script>
        document.addEventListener('astro:page-load', () => {
             const items = document.querySelectorAll('.gallery-item');
             items.forEach(item => {
                 item.addEventListener('click', () => {
                     const index = parseInt(item.getAttribute('data-index') || '0');
                     window.dispatchEvent(new CustomEvent('open-lightbox', { detail: { index } }));
                 });
             });
        });
    </script>
</Base>

---
import Base from "@/layouts/Base.astro";
---

<Base title="Page Not Found">
  <section class="section">
    <div class="container">
      <div class="flex h-[50vh] items-center justify-center">
        <div class="text-center">
          <p class="text-[72px] md:text-[140px] leading-none font-black tracking-[0.08em] text-text-dark dark:text-text-light">
            404
          </p>
          <p class="mt-4 text-lg md:text-2xl uppercase tracking-[0.4em] text-text/60">
            Page Not Found
          </p>
          <a href="/" class="btn btn-primary mt-8">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

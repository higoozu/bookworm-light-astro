---
// src/pages/index.astro
import Base from "@/layouts/Base.astro";
import Hero from "@/layouts/components/Hero.astro";
import PostCard from "@/layouts/components/PostCard.astro";
import SelectionCard from "@/layouts/components/SelectionCard.astro";
import Explore from "@/layouts/components/Explore.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import homepage from "@/config/homepage.json";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);

const selectionPosts = sortedPosts
  .filter((post) => post.data.selection === true)
  .slice(0, 3);

const recentPosts = sortedPosts.slice(0, 6);
---

<Base>
  <Hero 
    title={homepage.hero.title} 
    description={homepage.hero.description} 
    image={homepage.hero.image}
    date={homepage.hero.date}
    link={homepage.hero.link}
  />

  <section class="bg-section-bg dark:bg-section-bg rounded-[3.5rem] my-12 pt-16 pb-8 md:py-24 transition-colors">
    <div class="container">
      <div class="flex justify-start mb-16 px-2 md:px-0">
        <div class="inline-block bg-badge-bg dark:bg-badge-bg rounded-full px-6 py-2 shadow-sm">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] m-0 text-badge-text dark:text-badge-text">Editor's Selection</h2>
        </div>
      </div>
      <div class="row gx-4">
        {selectionPosts.map((post) => (
          <div class="col-12 md:col-4 mb-8 md:mb-0 last:mb-0">
            <SelectionCard post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-serif italic font-bold text-text-dark dark:text-text-light">Explore by Destination</h2>
      </div>
      <Explore items={homepage.explore} />
    </div>
  </section>

  <section class="py-12">
    <div class="container">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-text-dark dark:text-text-light tracking-tighter text-left">Recent Stories</h2>
        </div>
        <a href="/blog" class="group flex items-center text-xs font-bold uppercase tracking-widest text-text-dark dark:text-text-light hover:text-primary transition-colors pb-1 border-b-2 border-transparent hover:border-primary">
          View All <span class="ml-2 transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      
      <div class="row gx-8">
        {recentPosts.map((post) => (
          <div class="col-12 sm:col-6 md:col-4 mb-16 md:mb-20">
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
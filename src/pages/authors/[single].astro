---
import Posts from "@/components/Posts.astro";
import Social from "@/components/Social.astro";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";
import { Picture } from "astro:assets";
import { render } from "astro:content";

export async function getStaticPaths() {
  const authors = await getSinglePage("authors");
  return authors.map((author) => ({
    params: { single: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const { title, meta_title, description, image, social } = author.data;
const { Content } = await render(author);

// Author Posts
const posts = await getSinglePage("posts");
const sortPostsByDate = sortByDate(posts);
const currentAuthorPosts = sortPostsByDate.filter((post) => {
  return post.data.authors
    .map((auth) => slugify(auth))
    .includes(slugify(title));
});

// Pagination
const { pagination } = config.settings;
const totalPages = Math.ceil(currentAuthorPosts.length / pagination);
const currentPosts = currentAuthorPosts.slice(0, pagination);

// Image Logic
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif}"
);
const placeholderImage = allImages["/src/assets/images/image-placeholder.png"];

// image is now ImageMetadata from schema
const imageSrc = image || placeholderImage();
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image?.src} 
>
  <section class="section">
    <div class="container">
      <!-- Header Section -->
      <div class="flex flex-row items-center justify-between mb-12 md:mb-16 gap-4 md:gap-8">
        
        <!-- Left Area: Avatar + Info Column -->
        <div class="flex flex-row items-start gap-4 md:gap-8 flex-1 max-w-3xl">
          {imageSrc && (
            <div class="w-20 h-20 md:w-32 md:h-32 overflow-hidden rounded-full shadow-lg shrink-0">
              <Picture
                src={imageSrc}
                alt={title}
                formats={['avif', 'webp']}
                widths={[160, 320]}
                sizes="(max-width: 768px) 80px, 128px"
                class="w-full h-full object-cover"
              />
            </div>
          )}
          
          <div class="flex flex-col flex-1 min-w-0">
            <h1 class="text-2xl md:text-4xl font-bold text-text-dark dark:text-text-light mb-1 md:mb-2">{title}</h1>
            <div class="content text-sm text-text/80 leading-relaxed mb-3 line-clamp-3 md:line-clamp-none">
               <Content />
            </div>
            
            <!-- Social Icons (Desktop & Mobile) -->
            <div class="mb-3">
              <Social source={social} className="social-icons-simple text-sm" />
            </div>

            <!-- Mobile Only Stats (Right of Avatar) -->
            <div class="md:hidden flex items-center gap-2">
                 <span class="text-[10px] font-bold text-text-dark dark:text-text-light uppercase tracking-[0.2em] bg-theme-light/50 dark:bg-theme-dark/50 px-3 py-1 rounded-full">
                    {currentAuthorPosts.length} {currentAuthorPosts.length > 1 ? 'ARTICLES' : 'ARTICLE'}
                 </span>
            </div>
          </div>
        </div>
        
        <!-- Desktop Right Stats -->
        <div class="hidden md:flex flex-col items-center gap-0 shrink-0 border-l border-border dark:border-border pl-8 md:pl-12">
          <span class="text-5xl font-bold text-text-dark dark:text-text-light leading-none">
            {currentAuthorPosts.length}
          </span>
          <span class="text-xs uppercase tracking-[0.2em] text-text/60 font-bold mt-3">
            {currentAuthorPosts.length > 1 ? 'articles' : 'article'}
          </span>
        </div>
      </div>

      <!-- Posts Grid -->
      {currentPosts.length > 0 ? (
        <>
          <Posts posts={currentPosts} showSummary={false} showAuthor={false} fluid={false} />
          
          {totalPages > 1 && (
            <Pagination 
              section={`/authors/${author.id}`} 
              currentPage={1} 
              totalPages={totalPages} 
            />
          )}
        </>
      ) : (
        <div class="text-center py-20">
            <p class="text-text/60">No posts found for this author.</p>
        </div>
      )}
    </div>
  </section>
</Base>
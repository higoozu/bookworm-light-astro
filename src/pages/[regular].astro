---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");

  const paths = pages.map((page) => ({
    params: {
      regular: page.slug,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const {
  title,
  meta_title,
  description,
  image,
  og_image,
  twitter_image,
  image_alt,
  canonical,
  noindex,
} = page.data;
const { Content } = await render(page);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  og_image={og_image || `/og/pages/${page.slug}.png`}
  twitter_image={twitter_image || `/og/pages/${page.slug}.png`}
  image_alt={image_alt}
  canonical={canonical}
  noindex={noindex}
>
  <section class="section">
    <div class="container">
      <h1 set:html={markdownify(title)} class="page-heading" />
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
</Base>

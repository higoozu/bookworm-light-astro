---
import Base from "@/layouts/Base.astro";
import { getTaxonomy, getAllTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import taxonomyData from "@/config/taxonomy.json";
import { Picture } from "astro:assets";

// Import all images from src/assets
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif}"
);

// 获取唯一分类列表
const categories = await getTaxonomy("posts", "categories");
// 获取所有分类用于计数
const allCategories = await getAllTaxonomy("posts", "categories");

// Helper to resolve image path to module
const resolveImage = (imagePath: string) => {
  // Convert public path (e.g. /images/posts/01.jpg) to assets path
  const assetPath = imagePath.startsWith("/images/")
    ? `/src/assets${imagePath}`
    : `/src/assets/images${imagePath}`;

  const imageModule = allImages[assetPath];

  if (!imageModule) {
    // Fallback to placeholder if not found
    return allImages["/src/assets/images/image-placeholder.png"];
  }
  return imageModule;
};

// 组合分类数据
const categoryItems = categories.map((category) => {
  const count = allCategories.filter((c) => c === category).length;
  const metadata = taxonomyData.categories?.find((item) => item.name === category);
  const imagePath = metadata?.image || "/images/image-placeholder.png";
  
  return {
    name: category,
    count: count,
    imageFunc: resolveImage(imagePath), // Return the glob function
  };
});
---

<Base>
  <section class="section">
    <div class="container">
      <h1 class="page-heading">Categories</h1>
      <div class="row g-2">
        {
          categoryItems.map((item) => (
            <div class="col-6 md:col-4 lg:col-3">
            <a 
              href={`/categories/${item.name}/`} 
              class="relative group aspect-square overflow-hidden block rounded-xl shadow-sm transition-all duration-300"
            >
              <Picture
                src={item.imageFunc()}
                alt={item.name}
                formats={['avif', 'webp']}
                widths={[400, 800]}
                sizes="(max-width: 768px) 50vw, 25vw"
                class="w-full h-full object-cover transition duration-700 group-hover:scale-110"
              />
              
              <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center transition-all duration-300 group-hover:bg-black/20">
                <span class="text-white dark:text-dark text-lg md:text-xl font-bold tracking-wider uppercase drop-shadow-md">
                  {humanize(item.name)}
                </span>
                <span class="text-white/90 dark:text-dark/90 text-sm mt-1 font-medium bg-black/20 px-3 py-0.5 rounded-full backdrop-blur-sm">
                  {item.count} {item.count > 1 ? 'articles' : 'article'}
                </span>
              </div>
            </a></div>
          ))
        }
      </div></div>
    </div>
  </section>
</Base>

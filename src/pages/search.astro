---
import Base from "@/layouts/Base.astro";
import Search from "astro-pagefind/components/Search";
---

<Base>
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-semibold tracking-wide mb-4 uppercase">
          Explore the journal
        </p>
        <h1 class="font-ui font-bold tracking-tight mb-4 text-text-dark dark:text-text-light">Search</h1>
        <p class="text-lg text-text max-w-2xl mx-auto">
          Find stories, galleries, and places across the site.
        </p>
      </div>

      <div class="search-shell mx-auto mt-10 max-w-4xl">
        <Search
          id="search"
          className="pagefind-ui"
          uiOptions={{ showImages: false, autofocus: true }}
        />
      </div>
    </div>
  </section>
</Base>

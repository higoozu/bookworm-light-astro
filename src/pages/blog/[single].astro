---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";

export async function getStaticPaths() {
  const BLOG_FOLDER = "posts";
  const posts = await getSinglePage(BLOG_FOLDER);

  const paths = posts.map((post) => ({
    params: {
      single: post.id,
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const {
  title,
  meta_title,
  image,
  description,
  pagefind,
  date,
  authors,
  categories,
  tags,
  og_image,
  twitter_image,
  image_alt,
  canonical,
  noindex,
} = post.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  og_image={og_image || `/og/posts/${post.id}.png`}
  twitter_image={twitter_image || `/og/posts/${post.id}.png`}
  image_alt={image_alt}
  ogType="article"
  publishedTime={date}
  authorNames={authors}
  section={categories?.[0]}
  tags={tags}
  canonical={canonical}
  noindex={noindex}
  pagefind={pagefind !== false}
>
  <PostSingle post={post} />
</Base>

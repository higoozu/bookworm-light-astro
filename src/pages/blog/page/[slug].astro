---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

export async function getStaticPaths() {
  const posts = await getSinglePage("posts");
  const { pagination } = config.settings;
  
  // Logic: Page 1 has 10 posts (1 hero + 9 grid). Subsequent pages have 9 posts.
  const postsOnFirstPage = pagination + 1;
  const remainingPosts = Math.max(0, posts.length - postsOnFirstPage);
  const totalPages = 1 + Math.ceil(remainingPosts / pagination);
  
  const paths = [];

  // Start generating paths from Page 2
  for (let i = 2; i <= totalPages; i++) {
    paths.push({
      params: {
        slug: i.toString(),
      },
    });
  }
  return paths;
}

const { slug } = Astro.params;
const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);

const { pagination } = config.settings;
const postsOnFirstPage = pagination + 1;
const remainingPosts = Math.max(0, sortedPosts.length - postsOnFirstPage);
const totalPages = 1 + Math.ceil(remainingPosts / pagination);

const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

// Calculate Slicing for Page 2+
// Page 2 starts after the first 10 posts.
// Index = 10 + (currentPage - 2) * 9
const indexOfFirstPost = postsOnFirstPage + (currentPage - 2) * pagination;
const indexOfLastPost = indexOfFirstPost + pagination;
const currentPosts = sortedPosts.slice(indexOfFirstPost, indexOfLastPost);
---

<Base title={`Blog - Page ${currentPage}`}>
  <section class="section">
    <div class="container text-center mb-10">
      <h1 class="h2 font-serif italic">All Stories</h1>
      <p class="text-text opacity-60 uppercase tracking-widest text-sm">Page {currentPage} of {totalPages}</p>
    </div>
    <div class="container">
      <Posts posts={currentPosts} className="mb-16" />
      <Pagination section="blog" totalPages={totalPages} currentPage={currentPage} />
    </div>
  </section>
</Base>